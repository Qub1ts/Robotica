define boxOne model
(
  size [0.5 0.5 0.5]
  gui_nose 0
)

define boxTwo model
(
  size [0.25 0.75 0.5]
  gui_nose 0
)

define boxThree model
(
  size [0.5 1.1 0.5]
  gui_nose 0
)

define boxFour model
(
  size [1.0 1.0 1.0]
  gui_nose 0
)

define sonarring ranger
(
  sensor
  ( 			
   range [ 0.0  3.0 ] # min and max range
   fov 180 # front field of view
   samples 8 # number of samples to return
  )

  # the visual rep of the ranger
  color "black"
  size [ 0.05 0.05 0.1 ]
)

define mycamera camera
(
  range [ 0.2 8.0 ]
  resolution [ 320 240 ]
  fov [ 53 40 ]
  pantilt [ 0 50 ]
  alwayson 1
)

define erratic position
(
  size [0.35 0.35 0.15]
  origin [-0.05 0 0 0]
  gui_nose 1
  drive "diff"
  sonarring(pose [ 0.050 0.000 0 0.000 ])
  mycamera(pose [ .10 0 .35 90.0 ])
)

define ground model
(
  gui_nose 0
  gui_grid 0
  gui_outline 0
  gui_move 0
  gripper_return 0
  fiducial_return 0
  obstacle_return 0
)

# set the resolution of the underlying raytrace model in meters
resolution 0.02

# simulation timestep in milliseconds
interval_sim 100  

window
( 
  size [ 500 500 ] 
  rotate [ 0 0 ]
  scale 60
)

ground
( 
  name "line"
  color "blue"
  bitmap "../runTest-worlds/lineBackground-pruebaEntrega.png"
  # This is the size in metres of the simulation x y z (height)
  size [7 7 0.001]
  pose [ 0 0 0 0 ]
  obstacle_return 0
  laser_return 0
)

erratic( pose [ -3.3 3.3 0 -40.000 ] name "era" color "blue")

boxFour( pose [ 0.45 2.35 0 137.51 ] name "box1a" color "gray30")
boxTwo( pose [ 1.13 2.43 0 -83.09 ] name "box1b" color "gray30")
boxTwo( pose [ -1.20 -0.06 0 145.15 ] name "box2" color "gray30")
boxTwo( pose [ 0.98 0.19 0 -103.14 ] name "box3" color "gray30")
boxThree( pose [ 2.59 -1.84 0 -173.79 ] name "box4" color "gray30")
